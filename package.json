    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "next": "15.5.28",
    "nodemailer": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",

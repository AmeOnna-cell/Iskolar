# Copy to .env.local and fill in. Never commit .env.local.
# Local Supabase values come from `npx supabase status`; cloud values from Supabase → Project settings → API.

# ---- Email (Gmail SMTP) — required: the server refuses to start without these. See docs/setup-smtp.md.
# The Gmail address that sends Iskolar's emails.
GMAIL_USER=
# 16-character Google App Password (needs 2-Step Verification). Not your normal Gmail password.
GMAIL_APP_PASSWORD=
# Sender name shown in inboxes.
EMAIL_FROM_NAME=Iskolar
# Base URL for links in emails, e.g. http://localhost:3000 locally or https://your-app.vercel.app in production.
APP_URL=

# ---- Supabase (Dashboard → Project settings → API Keys; locally `npx supabase status`)
# Public (safe in the browser). The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses RLS. Never import in client code (src/lib/supabase/admin.ts is guarded by
# `server-only`). The legacy name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=

# ---- Web push. Generate a pair with `npx web-push generate-vapid-keys`. Optional: without them the
# push option is shown as unavailable. The public key is read by the browser and the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Scheduled reminders: shared secret pg_cron sends to /api/cron/dispatch (16+ characters).
# The same value goes in Supabase Vault as `iskolar_cron_secret` (docs/notifications.md).
CRON_SECRET=

# ---- Optional
# Emails per rolling 24 hours (default 450, under Gmail's ~500/day; Google Workspace allows 2,000).
EMAIL_DAILY_LIMIT=
# Local development only: send to Supabase's Mailpit inbox instead of Gmail, e.g. 127.0.0.1:54325.
# Only a loopback address is accepted.
EMAIL_DEV_SMTP=
